config {
  type: "view",
  schema: "reporting",
  name: "v_seo_health_kpis",
  description: "SEO Health KPI metrics for dashboard top row",
  tags: ["reporting", "seo", "health", "kpis", "analytics"]
}

/*
 * SEO Health KPIs View
 * 
 * Purpose: Provides percentage metrics for videos with tags, custom thumbnails, captions,
 * and average title/description lengths for the selected channel and time range.
 * 
 * Business Logic:
 * - Calculates percentages of videos with SEO elements (tags, thumbnails, captions)
 * - Computes average title and description lengths
 * - Filters for videos published in the last 90 days
 * - Groups by channel for dashboard filtering
 * 
 * Columns:
 *   channel_sk                : surrogate key for the channel
 *   channel_id                : YouTube channel id
 *   channel_title             : Channel title
 *   pct_videos_with_tags      : percentage of videos with tags (0-100)
 *   pct_with_custom_thumbnail : percentage of videos with custom thumbnails (0-100)
 *   pct_with_captions         : percentage of videos with captions (0-100)
 *   avg_title_length          : average title length in characters
 *   avg_description_length    : average description length in characters
 *   total_videos              : total number of videos in the dataset
 *   date_range_start          : start date of the analysis period
 *   date_range_end            : end date of the analysis period
 */

WITH video_metrics AS (
  SELECT
    dv.channel_sk,
    c.channel_id,
    c.channel_title,
    dv.video_id,
    dv.title AS video_title,
    dv.published_at,
    dv.has_tags,
    dv.has_custom_thumbnail,
    dv.has_captions,
    dv.title_len,
    dv.description_len,
    dv.seo_score,
    dv.length_bucket,
    -- Get latest view count for the video
    fv.view_count_total AS views_latest
  FROM ${ref("gold", "dim_video")} dv
  LEFT JOIN ${ref("gold", "dim_channel")} c 
    ON dv.channel_sk = c.channel_sk
  LEFT JOIN (
    -- Get latest snapshot for each video
    SELECT 
      video_sk,
      view_count_total,
      ROW_NUMBER() OVER (PARTITION BY video_sk ORDER BY date_key DESC) as rn
    FROM ${ref("gold", "f_video_daily_snapshot")}
  ) fv ON dv.video_sk = fv.video_sk AND fv.rn = 1
  WHERE dv.is_current = TRUE
    AND c.is_current = TRUE
    -- Filter for videos published in the last 90 days (configurable)
    AND dv.published_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 90 DAY)
)

SELECT
  channel_sk,
  channel_id,
  channel_title,
  -- Calculate percentages (multiply by 100 for display)
  ROUND(SAFE_DIVIDE(COUNTIF(has_tags = TRUE), COUNT(*)) * 100, 0) AS pct_videos_with_tags,
  ROUND(SAFE_DIVIDE(COUNTIF(has_custom_thumbnail = TRUE), COUNT(*)) * 100, 0) AS pct_with_custom_thumbnail,
  ROUND(SAFE_DIVIDE(COUNTIF(has_captions = TRUE), COUNT(*)) * 100, 0) AS pct_with_captions,
  -- Calculate averages
  ROUND(AVG(title_len), 0) AS avg_title_length,
  ROUND(AVG(description_len), 0) AS avg_description_length,
  -- Additional metrics
  COUNT(*) AS total_videos,
  DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY) AS date_range_start,
  CURRENT_DATE() AS date_range_end
FROM video_metrics
GROUP BY channel_sk, channel_id, channel_title

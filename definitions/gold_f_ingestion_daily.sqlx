config {
  type: "incremental",
  schema: "gold",
  name: "f_ingestion_daily",
  description: "Ingestion pipeline health per channel/day",
  tags: ["gold", "fact", "ingestion", "monitoring"],
  
  uniqueKey: ["date_key", "channel_sk"],
  
  bigquery: {
    clusterBy: ["date_key", "channel_sk"]
  }
}

/*
 * Ingestion daily fact table
 * Tracks pipeline health and data quality per channel
 */

WITH ingestion_data AS (
  SELECT
    channel_id,
    last_ingest_at,
    error_flag,
    snapshot_date
  FROM ${ref("silver", "silver_ingestion_log")}
  WHERE 
    channel_id IS NOT NULL
    -- Date filter: process specific date from DAG parameter (if provided)
    ${ when(dataform.projectConfig.vars.target_date, 
      `AND snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    -- Incremental mode: process last 7 days rolling window (if not full refresh and no target_date)
    -- Only applies when: incremental mode AND no full_refresh variable AND no target_date
    ${ when(incremental() && !dataform.projectConfig.vars.full_refresh && !dataform.projectConfig.vars.target_date, 
      `AND snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
    -- If full_refresh is set or first run, process ALL dates from Silver
),

channel_lookup AS (
  SELECT
    channel_sk,
    channel_id,
    is_current
  FROM ${ref("gold", "dim_channel")}
  WHERE is_current = TRUE
),

ingestion_with_sk AS (
  SELECT
    i.channel_id,
    i.last_ingest_at,
    i.error_flag,
    i.snapshot_date,
    cl.channel_sk
  FROM ingestion_data i
  LEFT JOIN channel_lookup cl ON i.channel_id = cl.channel_id
  WHERE cl.channel_sk IS NOT NULL
)

SELECT
  CAST(FORMAT_DATE('%Y%m%d', snapshot_date) AS INT64) AS date_key,
  channel_sk,
  last_ingest_at,
  error_flag
FROM ingestion_with_sk

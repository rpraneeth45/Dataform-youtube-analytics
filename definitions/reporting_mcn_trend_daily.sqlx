config {
  type: "view",
  schema: "reporting",
  name: "mcn_trend_daily",
  description: "MCN daily trends",
  tags: ["reporting", "mcn", "trends", "analytics"]
}

/*
 * MCN Daily Trends View
 * 
 * Purpose: Provides daily aggregates of video view deltas and total subscribers for trend analysis 
 * and cumulative metrics across the whole MCN population.
 * 
 * Business Logic:
 * - Aggregates video views by date across all MCNs
 * - Calculates cumulative views using window functions
 * - Carries forward subscriber counts using LAST_VALUE
 */

WITH
  video_views_by_date AS (
    SELECT
      vds.date_key,
      SUM(IFNULL(vds.view_delta, 0)) AS views_delta
    FROM ${ref("gold", "f_video_daily_snapshot")} vds
    GROUP BY vds.date_key
  ),

  subs_by_date AS (
    SELECT
      cds.date_key,
      SUM(IFNULL(cds.subscriber_count, 0)) AS total_subscribers
    FROM ${ref("gold", "f_channel_daily_snapshot")} cds
    GROUP BY cds.date_key
  )

SELECT
  d.date_key,
  d.full_date,
  COALESCE(v.views_delta, 0) AS daily_views,
  SUM(COALESCE(v.views_delta, 0)) OVER (ORDER BY d.date_key ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_views,
  -- carry forward the last known non-null subscriber count up to each date
  LAST_VALUE(s.total_subscribers IGNORE NULLS)
    OVER (ORDER BY d.date_key ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS total_subscribers
FROM ${ref("gold", "dim_date")} d
LEFT JOIN video_views_by_date v ON d.date_key = v.date_key
LEFT JOIN subs_by_date s ON d.date_key = s.date_key
ORDER BY d.date_key

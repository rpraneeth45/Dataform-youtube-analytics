config {
  type: "assertion",
  name: "assert_bronze_to_silver_row_counts",
  description: "Ensure Bronze → Silver transformation doesn't lose significant data",
  tags: ["silver", "quality"]
}

/*
 * Data Quality Check: Row Count Reconciliation
 * 
 * Verifies that Silver has at least 90% of Bronze rows.
 * Some loss is acceptable due to filtering invalid records.
 * 
 * How it works:
 * - Compares row counts between Bronze and Silver tables
 * - Calculates retention percentage (Silver / Bronze)
 * - Fails if retention < 90% or if Silver data is missing
 * 
 * Expected Result: 0 rows (retention >= 90% for all resources)
 * Failure: Any rows returned = data loss detected = pipeline stops
 */

WITH bronze_counts AS (
  SELECT 
    'channels' as resource,
    bronze.snapshot_date,
    SUM(ARRAY_LENGTH(bronze.items)) as bronze_count
  FROM `tonal-transit-475913-a2.control.bronze_channels_external` AS bronze
  WHERE
    -- If target_date is provided, check only that date
    ${ when(dataform.projectConfig.vars.target_date, 
      `bronze.snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    -- If no target_date, check recent partitions (last 7 days)
    ${ when(!dataform.projectConfig.vars.target_date, 
      `bronze.snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
  GROUP BY bronze.snapshot_date
  
  UNION ALL
  
  SELECT 
    'videos' as resource,
    bronze.snapshot_date,
    SUM(ARRAY_LENGTH(bronze.items)) as bronze_count
  FROM `tonal-transit-475913-a2.control.bronze_videos_external` AS bronze
  WHERE
    -- If target_date is provided, check only that date
    ${ when(dataform.projectConfig.vars.target_date, 
      `bronze.snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    -- If no target_date, check recent partitions (last 7 days)
    ${ when(!dataform.projectConfig.vars.target_date, 
      `bronze.snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
  GROUP BY bronze.snapshot_date
),

silver_counts AS (
  SELECT 
    'channels' as resource,
    snapshot_date,
    COUNT(*) as silver_count
  FROM ${ref("silver", "silver_channel")}
  WHERE
    -- If target_date is provided, check only that date
    ${ when(dataform.projectConfig.vars.target_date, 
      `snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    -- If no target_date, check recent partitions (last 7 days)
    ${ when(!dataform.projectConfig.vars.target_date, 
      `snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
  GROUP BY snapshot_date
  
  UNION ALL
  
  SELECT 
    'videos' as resource,
    snapshot_date,
    COUNT(*) as silver_count
  FROM ${ref("silver", "silver_video")}
  WHERE
    -- If target_date is provided, check only that date
    ${ when(dataform.projectConfig.vars.target_date, 
      `snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    -- If no target_date, check recent partitions (last 7 days)
    ${ when(!dataform.projectConfig.vars.target_date, 
      `snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
  GROUP BY snapshot_date
)

SELECT 
  b.resource,
  b.snapshot_date,
  b.bronze_count,
  s.silver_count,
  ROUND((s.silver_count / NULLIF(b.bronze_count, 0)) * 100, 2) as retention_pct
FROM bronze_counts b
LEFT JOIN silver_counts s 
  ON b.resource = s.resource 
  AND b.snapshot_date = s.snapshot_date
WHERE 
  -- Silver data missing entirely
  s.silver_count IS NULL
  -- OR retention rate is below 90%
  OR (b.bronze_count > 0 AND (s.silver_count / b.bronze_count) < 0.90)


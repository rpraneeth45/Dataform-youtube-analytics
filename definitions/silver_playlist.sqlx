config {
  type: "incremental",
  schema: "silver",
  name: "silver_playlist",
  description: "YouTube playlist metadata",
  tags: ["silver", "playlists"],
  
  bigquery: {
    partitionBy: "snapshot_date",
    clusterBy: ["channel_id", "playlist_id"],
    updatePartitionFilter: "snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)"
  },
  
  columns: {
    playlist_id: "YouTube playlist ID",
    channel_id: "YouTube channel ID (foreign key)",
    title: "Playlist title",
    description: "Playlist description",
    item_count: "Number of items in playlist",
    published_at: "Playlist creation timestamp",
    snapshot_date: "Date of data snapshot (partition key)"
  }
}

/*
 * Transform Bronze playlist data to Silver layer
 * 
 * Source: control.bronze_playlists_external (GCS external table)
 * Target: silver.silver_playlist (native BigQuery table)
 * 
 * Transformations:
 * - Parse nested JSON from YouTube API
 * - Extract playlist metadata
 * - Clean and type-cast fields
 */

SELECT
  -- Identifiers
  JSON_EXTRACT_SCALAR(item, '$.id') AS playlist_id,
  JSON_EXTRACT_SCALAR(item, '$.snippet.channelId') AS channel_id,
  
  -- Metadata
  JSON_EXTRACT_SCALAR(item, '$.snippet.title') AS title,
  JSON_EXTRACT_SCALAR(item, '$.snippet.description') AS description,
  
  -- Statistics
  SAFE_CAST(JSON_EXTRACT_SCALAR(item, '$.contentDetails.itemCount') AS INT64) AS item_count,
  
  -- Timestamps
  PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%SZ', JSON_EXTRACT_SCALAR(item, '$.snippet.publishedAt')) AS published_at,
  
  -- Partition Key
  PARSE_DATE('%Y-%m-%d', JSON_EXTRACT_SCALAR(bronze, '$.snapshot_date')) AS snapshot_date

FROM 
  ${ref("control", "bronze_playlists_external")} AS bronze,
  UNNEST(JSON_EXTRACT_ARRAY(bronze, '$.items')) AS item

WHERE
  -- Only process records with valid playlist IDs
  JSON_EXTRACT_SCALAR(item, '$.id') IS NOT NULL
  
  -- Date filter: process specific date from DAG parameter
  ${ when(dataform.projectConfig.vars.target_date, 
    `AND PARSE_DATE('%Y-%m-%d', JSON_EXTRACT_SCALAR(bronze, '$.snapshot_date')) = '${dataform.projectConfig.vars.target_date}'`
  ) }
  
  -- Incremental filter: only reprocess recent partitions if no target_date specified
  ${ when(incremental() && !dataform.projectConfig.vars.target_date, 
    `AND PARSE_DATE('%Y-%m-%d', JSON_EXTRACT_SCALAR(bronze, '$.snapshot_date')) >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`) }


config {
  type: "table",
  schema: "gold",
  name: "dim_video",
  description: "Video dimension with SCD2 and SEO attributes",
  tags: ["gold", "dimension", "video", "scd2", "seo"],
  
  bigquery: {
    clusterBy: ["channel_sk", "length_bucket"]
  }
}

/*
 * Video dimension with SCD2 implementation
 * Tracks historical changes to video attributes
 * Includes SEO metrics and length categorization
 * 
 * SCD2 Logic:
 * - effective_start_date: Set to CURRENT_DATE() when record is inserted (audit column)
 * - effective_end_date: Set to CURRENT_DATE() - 1 when record becomes inactive (audit column)
 * - is_current: Automatically set to FALSE for previous records when new record arrives
 * - created_at: Original video publish timestamp from source data (published_at)
 */
WITH
-- Get videos that have snapshots in the date range (for incremental efficiency)
-- During incremental runs, only process entities that changed in last 7 days
-- But include ALL historical snapshots for those entities (needed for SCD2)
videos_in_range AS (
  SELECT DISTINCT video_id
  FROM ${ref("silver", "silver_video")}
  WHERE 
    video_id IS NOT NULL
    -- Date filter: process specific date from DAG parameter (if provided)
    ${ when(dataform.projectConfig.vars.target_date, 
      `AND snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    -- Incremental mode: only process entities with snapshots in last 7 days
    -- Only applies when: no full_refresh variable AND no target_date
    ${ when(!dataform.projectConfig.vars.full_refresh && !dataform.projectConfig.vars.target_date, 
      `AND snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
    -- If full_refresh is set, process ALL videos (no filter)
),

-- Get ALL historical data for videos in range (needed for complete SCD2 timelines)
video_data AS (
  SELECT
    v.video_id,
    v.channel_id,
    v.title,
    v.description,
    v.published_at,
    v.duration_sec,
    v.has_tags,
    v.has_custom_thumbnail,
    v.has_captions,
    v.title_len,
    v.description_len,
    v.seo_score,
    v.snapshot_date
  FROM ${ref("silver", "silver_video")} v
  ${ when(!dataform.projectConfig.vars.full_refresh && !dataform.projectConfig.vars.target_date, 
    `INNER JOIN videos_in_range vir ON v.video_id = vir.video_id`
  ) }
  WHERE 
    v.video_id IS NOT NULL
    -- Date filter: process specific date from DAG parameter (if provided)
    ${ when(dataform.projectConfig.vars.target_date, 
      `AND v.snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    -- If full_refresh is set, process ALL dates from Silver (no filter)
),

channel_lookup AS (
  SELECT
    channel_sk,
    channel_id,
    is_current
  FROM ${ref("gold", "dim_channel")}
  WHERE is_current = TRUE
),

video_with_channel AS (
  SELECT
    v.video_id,
    c.channel_sk,
    v.title,
    v.description,
    v.published_at,
    v.duration_sec,
    v.has_tags,
    v.has_custom_thumbnail,
    v.has_captions,
    v.title_len,
    v.description_len,
    v.seo_score,
    v.snapshot_date
  FROM video_data v
  LEFT JOIN channel_lookup c ON v.channel_id = c.channel_id
),

-- Add length bucket categorization
video_with_buckets AS (
  SELECT
    *,
    CASE 
      WHEN duration_sec < 60 THEN 'Short'
      WHEN duration_sec < 300 THEN 'Mid'  -- 5 minutes
      ELSE 'Long'
    END AS length_bucket
  FROM video_with_channel
),

-- Get latest snapshot per video to identify current state
latest_video_snapshot AS (
  SELECT
    video_id,
    MAX(snapshot_date) AS latest_snapshot_date
  FROM video_with_buckets
  GROUP BY video_id
),

-- Get current state from latest snapshot
current_video_state AS (
  SELECT
    v.video_id,
    v.channel_sk,
    v.title,
    v.description,
    v.published_at,
    v.duration_sec,
    v.has_tags,
    v.has_custom_thumbnail,
    v.has_captions,
    v.title_len,
    v.description_len,
    v.seo_score,
    v.length_bucket,
    v.snapshot_date
  FROM video_with_buckets v
  INNER JOIN latest_video_snapshot l
    ON v.video_id = l.video_id
    AND v.snapshot_date = l.latest_snapshot_date
),

-- Get existing current records from dimension table
-- Use direct table reference to avoid circular dependency in incremental mode
existing_current_records AS (
  SELECT
    video_sk,
    video_id,
    channel_sk,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    length_bucket,
    effective_start_date,
    effective_end_date,
    is_current
  FROM `tonal-transit-475913-a2.gold.dim_video`
  WHERE is_current = TRUE
),

-- Detect changes: compare current state with existing records
changed_videos AS (
  SELECT
    c.video_id,
    c.channel_sk,
    c.title,
    c.description,
    c.published_at,
    c.duration_sec,
    c.has_tags,
    c.has_custom_thumbnail,
    c.has_captions,
    c.title_len,
    c.description_len,
    c.seo_score,
    c.length_bucket,
    e.video_sk AS existing_video_sk,
    e.title AS existing_title,
    e.seo_score AS existing_seo_score,
    -- Check if any tracked attribute changed
    CASE 
      WHEN e.video_id IS NULL THEN TRUE  -- New video
      WHEN c.title != e.title THEN TRUE  -- Title changed
      WHEN c.seo_score != e.seo_score 
        OR (c.seo_score IS NULL AND e.seo_score IS NOT NULL)
        OR (c.seo_score IS NOT NULL AND e.seo_score IS NULL)
      THEN TRUE  -- SEO score changed
      ELSE FALSE  -- No change
    END AS has_change
  FROM current_video_state c
  LEFT JOIN existing_current_records e
    ON c.video_id = e.video_id
),

-- Get max video_sk to generate new surrogate keys
max_video_sk AS (
  SELECT COALESCE(MAX(video_sk), 0) AS max_sk
  FROM `tonal-transit-475913-a2.gold.dim_video`
),

-- Prepare new/updated records to insert
new_records AS (
  SELECT
    c.video_id,
    c.channel_sk,
    c.title,
    c.description,
    c.published_at,
    c.duration_sec,
    c.has_tags,
    c.has_custom_thumbnail,
    c.has_captions,
    c.title_len,
    c.description_len,
    c.seo_score,
    c.length_bucket,
    -- Generate new surrogate key: use max_sk + row_number
    m.max_sk + ROW_NUMBER() OVER (ORDER BY c.video_id) AS video_sk,
    -- Set effective_start_date to today (audit column - insertion time)
    CURRENT_DATE() AS effective_start_date
  FROM changed_videos c
  CROSS JOIN max_video_sk m
  WHERE c.has_change = TRUE
),

-- Get all existing records to calculate SCD2 fields for all records
all_existing_records AS (
  SELECT
    video_sk,
    video_id,
    channel_sk,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    length_bucket,
    effective_start_date
  FROM `tonal-transit-475913-a2.gold.dim_video`
),

-- Combine existing + new records to calculate effective_end_date for all records
all_records AS (
  SELECT
    video_sk,
    video_id,
    channel_sk,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    length_bucket,
    effective_start_date
  FROM all_existing_records
  
  UNION ALL
  
  SELECT
    video_sk,
    video_id,
    channel_sk,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    length_bucket,
    effective_start_date
  FROM new_records
),

-- Calculate SCD2 fields using window functions
-- This determines effective_end_date and is_current for all records
scd2_calculated AS (
  SELECT
    video_sk,
    video_id,
    channel_sk,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    length_bucket,
    TIMESTAMP(published_at) AS created_at,
    effective_start_date,
    -- Calculate effective_end_date: next record's effective_start_date - 1 day
    DATE_SUB(
      LEAD(effective_start_date) OVER (
        PARTITION BY video_id 
        ORDER BY effective_start_date
      ),
      INTERVAL 1 DAY
    ) AS effective_end_date,
    -- Calculate is_current: TRUE if this is the latest record for this video_id
    CASE 
      WHEN LEAD(effective_start_date) OVER (
        PARTITION BY video_id 
        ORDER BY effective_start_date
      ) IS NULL THEN TRUE 
      ELSE FALSE 
    END AS is_current
  FROM all_records
)

-- Build complete SCD2 table with all records and correct flags
-- This replaces the entire table, ensuring all records have correct is_current and effective_end_date
-- Note: ORDER BY removed to avoid conflict with table clustering
SELECT
  video_sk,
  video_id,
  channel_sk,
  title,
  description,
  published_at,
  duration_sec,
  has_tags,
  has_custom_thumbnail,
  has_captions,
  title_len,
  description_len,
  seo_score,
  length_bucket,
  created_at,
  effective_start_date,
  effective_end_date,
  is_current
FROM scd2_calculated

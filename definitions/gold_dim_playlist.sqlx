config {
  type: "table",
  schema: "gold",
  name: "dim_playlist",
  description: "Playlist dimension with SCD2",
  tags: ["gold", "dimension", "playlist", "scd2"]
}

/*
 * Playlist dimension with SCD2 implementation
 * Tracks historical changes to playlist attributes
 * 
 * SCD2 Logic:
 * - effective_start_date: Set to CURRENT_DATE() when record is inserted (audit column)
 * - effective_end_date: Set to CURRENT_DATE() - 1 when record becomes inactive (audit column)
 * - is_current: Automatically set to FALSE for previous records when new record arrives
 * - created_at: Original playlist creation timestamp from source data (published_at)
 */

WITH playlist_data AS (
  SELECT
    playlist_id,
    title,
    item_count,
    published_at,
    snapshot_date
  FROM ${ref("silver", "silver_playlist")}
  WHERE playlist_id IS NOT NULL
),

-- Get latest snapshot per playlist to identify current state
latest_playlist_snapshot AS (
  SELECT
    playlist_id,
    MAX(snapshot_date) AS latest_snapshot_date
  FROM playlist_data
  GROUP BY playlist_id
),

-- Get current state from latest snapshot
current_playlist_state AS (
  SELECT
    p.playlist_id,
    p.title,
    p.item_count,
    p.published_at,
    p.snapshot_date
  FROM playlist_data p
  INNER JOIN latest_playlist_snapshot l
    ON p.playlist_id = l.playlist_id
    AND p.snapshot_date = l.latest_snapshot_date
),

-- Get existing current records from dimension table
-- Use direct table reference to avoid circular dependency in incremental mode
existing_current_records AS (
  SELECT
    playlist_sk,
    playlist_id,
    playlist_title AS title,
    playlist_item_count AS item_count,
    published_at,
    effective_start_date,
    effective_end_date,
    is_current
  FROM `tonal-transit-475913-a2.gold.dim_playlist`
  WHERE is_current = TRUE
),

-- Detect changes: compare current state with existing records
changed_playlists AS (
  SELECT
    c.playlist_id,
    c.title,
    c.item_count,
    c.published_at,
    e.playlist_sk AS existing_playlist_sk,
    e.title AS existing_title,
    e.item_count AS existing_item_count,
    -- Check if any tracked attribute changed
    CASE 
      WHEN e.playlist_id IS NULL THEN TRUE  -- New playlist
      WHEN c.title != e.title THEN TRUE  -- Title changed
      WHEN c.item_count != e.item_count 
        OR (c.item_count IS NULL AND e.item_count IS NOT NULL)
        OR (c.item_count IS NOT NULL AND e.item_count IS NULL)
      THEN TRUE  -- Item count changed
      ELSE FALSE  -- No change
    END AS has_change
  FROM current_playlist_state c
  LEFT JOIN existing_current_records e
    ON c.playlist_id = e.playlist_id
),

-- Get max playlist_sk to generate new surrogate keys
max_playlist_sk AS (
  SELECT COALESCE(MAX(playlist_sk), 0) AS max_sk
  FROM `tonal-transit-475913-a2.gold.dim_playlist`
),

-- Prepare new/updated records to insert
new_records AS (
  SELECT
    c.playlist_id,
    c.title AS playlist_title,
    c.item_count AS playlist_item_count,
    c.published_at,
    -- Generate new surrogate key: use max_sk + row_number
    m.max_sk + ROW_NUMBER() OVER (ORDER BY c.playlist_id) AS playlist_sk,
    -- Set effective_start_date to today (audit column - insertion time)
    CURRENT_DATE() AS effective_start_date
  FROM changed_playlists c
  CROSS JOIN max_playlist_sk m
  WHERE c.has_change = TRUE
),

-- Get all existing records to calculate SCD2 fields for all records
all_existing_records AS (
  SELECT
    playlist_sk,
    playlist_id,
    playlist_title,
    playlist_item_count,
    published_at,
    effective_start_date
  FROM `tonal-transit-475913-a2.gold.dim_playlist`
),

-- Combine existing + new records to calculate effective_end_date for all records
all_records AS (
  SELECT
    playlist_sk,
    playlist_id,
    playlist_title,
    playlist_item_count,
    published_at,
    effective_start_date
  FROM all_existing_records
  
  UNION ALL
  
  SELECT
    playlist_sk,
    playlist_id,
    playlist_title,
    playlist_item_count,
    published_at,
    effective_start_date
  FROM new_records
),

-- Calculate SCD2 fields using window functions
-- This determines effective_end_date and is_current for all records
scd2_calculated AS (
  SELECT
    playlist_sk,
    playlist_id,
    playlist_title,
    playlist_item_count,
    published_at,
    -- Use published_at as created_at timestamp (original playlist creation time)
    TIMESTAMP(published_at) AS created_at,
    effective_start_date,
    -- Calculate effective_end_date: next record's effective_start_date - 1 day
    DATE_SUB(
      LEAD(effective_start_date) OVER (
        PARTITION BY playlist_id 
        ORDER BY effective_start_date
      ),
      INTERVAL 1 DAY
    ) AS effective_end_date,
    -- Calculate is_current: TRUE if this is the latest record for this playlist_id
    CASE 
      WHEN LEAD(effective_start_date) OVER (
        PARTITION BY playlist_id 
        ORDER BY effective_start_date
      ) IS NULL THEN TRUE 
      ELSE FALSE 
    END AS is_current
  FROM all_records
)

-- Build complete SCD2 table with all records and correct flags
-- This replaces the entire table, ensuring all records have correct is_current and effective_end_date
-- Note: ORDER BY removed to avoid conflict with table clustering
SELECT
  playlist_sk,
  playlist_id,
  playlist_title,
  playlist_item_count,
  published_at,
  created_at,
  effective_start_date,
  effective_end_date,
  is_current
FROM scd2_calculated

config {
  type: "incremental",
  schema: "gold",
  name: "bridge_playlist_video",
  description: "Bridge table: playlist to video mapping",
  tags: ["gold", "bridge", "playlist", "video"],
  
  uniqueKey: ["playlist_sk", "video_sk"],
  
  bigquery: {
    clusterBy: ["playlist_sk", "video_sk"]
  }
}

/*
 * Bridge table for playlist-video relationships
 * Maps playlists to videos with current status tracking
 */

WITH playlist_video_data AS (
  SELECT
    pv.playlist_id,
    pv.video_id,
    pv.position,
    pv.is_current,
    pv.snapshot_date
  FROM ${ref("silver", "silver_playlist_video")} pv
  WHERE 
    pv.playlist_id IS NOT NULL 
    AND pv.video_id IS NOT NULL
    -- Date filter: process specific date from DAG parameter (if provided)
    ${ when(dataform.projectConfig.vars.target_date, 
      `AND pv.snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    -- Incremental mode: process last 7 days rolling window (if not full refresh and no target_date)
    -- Only applies when: incremental mode AND no full_refresh variable AND no target_date
    ${ when(incremental() && !dataform.projectConfig.vars.full_refresh && !dataform.projectConfig.vars.target_date, 
      `AND pv.snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
    -- If full_refresh is set or first run, process ALL dates from Silver
),

-- Get current playlist and video surrogate keys
playlist_lookup AS (
  SELECT
    playlist_sk,
    playlist_id,
    is_current
  FROM ${ref("gold", "dim_playlist")}
  WHERE is_current = TRUE
),

video_lookup AS (
  SELECT
    video_sk,
    video_id,
    is_current
  FROM ${ref("gold", "dim_video")}
  WHERE is_current = TRUE
),

bridge_data AS (
  SELECT
    pv.playlist_id,
    pv.video_id,
    pv.position,
    pv.is_current,
    pv.snapshot_date,
    pl.playlist_sk,
    vl.video_sk
  FROM playlist_video_data pv
  LEFT JOIN playlist_lookup pl ON pv.playlist_id = pl.playlist_id
  LEFT JOIN video_lookup vl ON pv.video_id = vl.video_id
  WHERE pl.playlist_sk IS NOT NULL 
    AND vl.video_sk IS NOT NULL
)

SELECT
  playlist_sk,
  video_sk,
  is_current
FROM bridge_data

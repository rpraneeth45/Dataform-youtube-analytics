config {
  type: "view",
  schema: "reporting",
  name: "mcn_top_channels_period",
  description: "MCN top channels per period",
  tags: ["reporting", "mcn", "channels", "leaderboard"]
}

/*
 * MCN Top Channels Per Period View
 * 
 * Purpose: Aggregates daily video-level deltas (views, likes, comments) up to channel and MCN level 
 * for leaderboard and top-channels reporting.
 * 
 * Business Logic:
 * - Aggregates video deltas to channel level
 * - Groups by date, channel, and MCN
 * - Provides daily performance metrics for leaderboards
 */

SELECT
  vds.date_key,
  DATE(PARSE_DATE('%Y%m%d', CAST(vds.date_key AS STRING))) AS full_date,
  vds.video_sk,
  dv.channel_sk,
  ch.channel_id,
  ch.channel_title,
  mg.mcn_group_sk,
  mg.mcn_group_name,
  SUM(IFNULL(vds.view_delta, 0)) AS views_in_day,
  SUM(IFNULL(vds.like_delta, 0)) AS likes_in_day,
  SUM(IFNULL(vds.comment_delta, 0)) AS comments_in_day,
  COUNT(DISTINCT vds.video_sk) AS videos_published_in_day
FROM ${ref("gold", "f_video_daily_snapshot")} vds
LEFT JOIN ${ref("gold", "dim_video")} dv
  ON vds.video_sk = dv.video_sk
LEFT JOIN ${ref("gold", "dim_channel")} ch
  ON dv.channel_sk = ch.channel_sk
LEFT JOIN ${ref("gold", "dim_mcn_group")} mg
  ON ch.mcn_group_sk = mg.mcn_group_sk
GROUP BY
  vds.date_key, vds.video_sk, dv.channel_sk, ch.channel_id, ch.channel_title, mg.mcn_group_sk, mg.mcn_group_name

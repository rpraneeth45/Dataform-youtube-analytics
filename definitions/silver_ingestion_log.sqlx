config {
  type: "incremental",
  schema: "silver",
  name: "silver_ingestion_log",
  description: "Ingestion status log by channel with error tracking (transactional - one record per channel per date)",
  tags: ["silver", "monitoring"],
  
  uniqueKey: ["channel_id", "snapshot_date"],
  
  bigquery: {
    partitionBy: "snapshot_date",
    clusterBy: ["channel_id"]
  },
  
  columns: {
    channel_id: "YouTube channel ID",
    last_ingest_at: "Timestamp of last ingestion attempt",
    error_flag: "Whether last ingestion had errors",
    snapshot_date: "Date of data snapshot (partition key)"
  }
}

/*
 * Transform ingestion run results to Silver monitoring layer
 * 
 * Source: control.ingestion_run_channels (control table)
 * Target: silver.silver_ingestion_log (native BigQuery table)
 * 
 * Purpose:
 * - Track ingestion success/failure by channel
 * - Enable monitoring and alerting
 * - Identify channels with persistent errors
 * 
 * Aggregation:
 * - Groups by channel_id and run_date
 * - Takes most recent run per day
 * - Marks error if status is not 'success'
 */

WITH ranked_runs AS (
  SELECT
    channel_id,
    run_date,
    status,
    error_message,
    run_id,
    
    -- Rank runs by run_id descending (most recent first)
    -- run_id is UUID, so we use it for deterministic ordering
    ROW_NUMBER() OVER (
      PARTITION BY channel_id, run_date 
      ORDER BY run_id DESC
    ) AS rn
  
  FROM ${ref("control", "ingestion_run_channels")}
  
  WHERE
    -- Always include valid run_date filter to ensure WHERE clause is never empty
    run_date IS NOT NULL
    
    -- Date filter: process specific date from DAG parameter (if provided)
    ${ when(dataform.projectConfig.vars.target_date, 
      `AND run_date = '${dataform.projectConfig.vars.target_date}'`
    ) }
    
    -- Incremental mode: process last 7 days rolling window (if not full refresh and no target_date)
    -- Only applies when: incremental mode AND no full_refresh variable AND no target_date
    ${ when(incremental() && !dataform.projectConfig.vars.full_refresh && !dataform.projectConfig.vars.target_date, 
      `AND run_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
    -- If full_refresh is set or first run, process ALL dates from control table (no additional filter)
)

SELECT
  channel_id,
  
  -- Use run_date as timestamp (no finer granularity available)
  TIMESTAMP(run_date) AS last_ingest_at,
  
  -- Error flag: true if status is not 'success'
  CASE 
    WHEN status IN ('failed', 'partial') THEN TRUE 
    ELSE FALSE 
  END AS error_flag,
  
  run_date AS snapshot_date

FROM ranked_runs

WHERE 
  -- Only keep the most recent run per channel per day
  rn = 1

config {
  type: "incremental",
  schema: "silver",
  name: "silver_playlist_video",
  description: "Mapping of videos to playlists with position tracking",
  tags: ["silver", "playlists", "videos"],

  bigquery: {
    partitionBy: "snapshot_date",
    clusterBy: ["playlist_id", "video_id"],
    updatePartitionFilter: "snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)"
  },

  columns: {
    playlist_id: "YouTube playlist ID",
    video_id: "YouTube video ID",
    position: "Position of video in playlist (0-indexed)",
    is_current: "Whether this is the most recent snapshot for this playlist-video pair",
    snapshot_date: "Date of data snapshot (partition key)"
  }
}

/*
 * Source: control.bronze_playlist_items_external (GCS external table)
 * Target: silver.silver_playlist_video
 */

WITH playlist_items AS (
  SELECT
    JSON_EXTRACT_SCALAR(bronze, '$.playlist_id') AS playlist_id,
    JSON_EXTRACT_SCALAR(item, '$.contentDetails.videoId') AS video_id,
    SAFE_CAST(JSON_EXTRACT_SCALAR(item, '$.snippet.position') AS INT64) AS position,
    PARSE_DATE('%Y-%m-%d', JSON_EXTRACT_SCALAR(bronze, '$.snapshot_date')) AS snapshot_date
  FROM
    ${ref("control","bronze_playlist_items_external")} AS bronze
  CROSS JOIN UNNEST(JSON_EXTRACT_ARRAY(bronze, '$.items')) AS item
  WHERE
    JSON_EXTRACT_SCALAR(bronze, '$.playlist_id') IS NOT NULL
    AND JSON_EXTRACT_SCALAR(item, '$.contentDetails.videoId') IS NOT NULL
    ${ when(dataform.projectConfig.vars.target_date,
      `AND PARSE_DATE('%Y-%m-%d', JSON_EXTRACT_SCALAR(bronze, '$.snapshot_date')) = '${dataform.projectConfig.vars.target_date}'`
    ) }
    ${ when(incremental() && !dataform.projectConfig.vars.target_date,
      `AND PARSE_DATE('%Y-%m-%d', JSON_EXTRACT_SCALAR(bronze, '$.snapshot_date')) >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`) }
),

latest_snapshots AS (
  SELECT
    playlist_id,
    video_id,
    MAX(snapshot_date) AS latest_snapshot_date
  FROM playlist_items
  GROUP BY playlist_id, video_id
)

SELECT
  pi.playlist_id,
  pi.video_id,
  pi.position,
  CASE WHEN pi.snapshot_date = ls.latest_snapshot_date THEN TRUE ELSE FALSE END AS is_current,
  pi.snapshot_date
FROM playlist_items pi
LEFT JOIN latest_snapshots ls
  ON pi.playlist_id = ls.playlist_id
 AND pi.video_id = ls.video_id
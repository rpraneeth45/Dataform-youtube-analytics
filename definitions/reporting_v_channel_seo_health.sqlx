config {
  type: "view",
  schema: "reporting",
  name: "v_channel_seo_health",
  description: "Overall channel SEO health percentage",
  tags: ["reporting", "seo", "health", "channel", "analytics"]
}

/*
 * Channel SEO Health View
 * 
 * Purpose: Provides the average SEO score across all videos for a channel,
 * displayed as a percentage for pie chart visualization.
 * 
 * Business Logic:
 * - Calculates average SEO score per channel
 * - Categorizes health levels (Poor, Fair, Good, Excellent)
 * - Filters for videos published in the last 90 days
 * - Provides total video count for context
 * 
 * Columns:
 *   channel_sk           : surrogate key for the channel
 *   channel_id           : YouTube channel id
 *   channel_title        : Channel title
 *   avg_seo_percentage   : average SEO score as percentage (0-100)
 *   total_videos         : total number of videos analyzed
 *   seo_health_category  : categorical health level (Poor, Fair, Good, Excellent)
 */

WITH video_metrics AS (
  SELECT
    dv.channel_sk,
    c.channel_id,
    c.channel_title,
    dv.seo_score,
    dv.video_published_at
  FROM ${ref("gold", "dim_video")} dv
  LEFT JOIN ${ref("gold", "dim_channel")} c 
    ON dv.channel_sk = c.channel_sk
  WHERE dv.is_current = TRUE
    AND c.is_current = TRUE
    -- Filter for videos published in the last 90 days (configurable)
    AND dv.video_published_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 90 DAY)
),

channel_aggregates AS (
  SELECT
    channel_sk,
    channel_id,
    channel_title,
    ROUND(AVG(seo_score), 1) AS avg_seo_percentage,
    COUNT(*) AS total_videos
  FROM video_metrics
  GROUP BY channel_sk, channel_id, channel_title
)

SELECT
  channel_sk,
  channel_id,
  channel_title,
  avg_seo_percentage,
  total_videos,
  CASE 
    WHEN avg_seo_percentage >= 80 THEN 'Excellent'
    WHEN avg_seo_percentage >= 60 THEN 'Good'
    WHEN avg_seo_percentage >= 40 THEN 'Fair'
    ELSE 'Poor'
  END AS seo_health_category
FROM channel_aggregates

config {
  type: "view",
  schema: "reporting",
  name: "v_channel_overview",
  description: "Channel overview (latest snapshot + 30-day aggregates)",
  tags: ["reporting", "channel", "overview", "analytics"]
}

/*
 * Channel Overview View
 * 
 * Purpose: Returns latest channel KPIs joined with lightweight 30-day aggregates for 
 * channel dashboards and reporting.
 * 
 * Business Logic:
 * - Gets latest snapshot per channel
 * - Includes current channel metadata (SCD2 current flag)
 * - Calculates 30-day engagement metrics
 * - Provides comprehensive channel performance data
 */

WITH latest_channel_snapshot AS (
  -- most recent snapshot date per channel
  SELECT
    channel_sk,
    MAX(date_key) AS latest_date_key
  FROM ${ref("gold", "f_channel_daily_snapshot")}
  GROUP BY channel_sk
),

snap AS (
  -- latest snapshot values for channels
  SELECT
    s.date_key,
    s.channel_sk,
    s.subscriber_count,
    s.view_count_total,
    s.video_count_total,
    s.subscriber_delta,
    s.view_delta,
    s.video_count_delta
  FROM ${ref("gold", "f_channel_daily_snapshot")} s
  JOIN latest_channel_snapshot l
    ON s.channel_sk = l.channel_sk AND s.date_key = l.latest_date_key
),

channel_meta AS (
  -- current channel metadata (SCD2 current flag)
  SELECT
    c.channel_sk,
    c.channel_id,
    c.channel_title,
    c.mcn_group_sk,
    c.created_at,
    c.effective_start_date,
    c.effective_end_date,
    c.is_current
  FROM ${ref("gold", "dim_channel")} c
  WHERE c.is_current = TRUE
)

SELECT
  c.channel_sk,
  c.channel_id,
  c.channel_title,
  c.mcn_group_sk,
  -- header KPIs (latest snapshot values)
  s.subscriber_count AS subscribers_latest,  -- latest subscribers
  s.view_count_total AS views_latest,        -- latest cumulative views
  s.video_count_total AS videos_catalog,     -- total videos in catalog
  -- recent deltas (from latest snapshot)
  s.subscriber_delta AS subscribers_delta_latest, -- delta in subscribers between last two snapshots
  s.view_delta AS views_delta_latest,             -- delta in views between last two snapshots
  s.video_count_delta AS videos_delta_latest,     -- delta in video counts between last two snapshots
  -- lightweight engagement proxy computed from aggregates over last N days (N=30)
  COALESCE(metrics.engagement_proxy_30d, 0) AS engagement_proxy_30d,
  COALESCE(metrics.avg_views_per_video_30d, 0) AS avg_views_per_video_30d,
  c.created_at,
  s.date_key AS latest_snapshot_date_key
FROM channel_meta c
LEFT JOIN snap s ON c.channel_sk = s.channel_sk
LEFT JOIN (
  -- 30-day aggregates for engagement KPIs (sliding window)
  SELECT
    v.channel_sk,
    SAFE_DIVIDE(SUM(v.like_count_total + v.comment_count_total), NULLIF(SUM(v.view_count_total),0)) AS engagement_proxy_30d,
    SAFE_DIVIDE(SUM(v.view_count_total), NULLIF(COUNT(DISTINCT v.video_sk),0)) AS avg_views_per_video_30d
  FROM (
    SELECT
      fv.date_key,
      fv.video_sk,
      fv.view_count_total,
      fv.like_count_total,
      fv.comment_count_total,
      dv.channel_sk
    FROM ${ref("gold", "f_video_daily_snapshot")} fv
    JOIN ${ref("gold", "dim_video")} dv ON fv.video_sk = dv.video_sk
    WHERE fv.date_key BETWEEN CAST(FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)) AS INT64)
                         AND CAST(FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)) AS INT64)
  ) v
  GROUP BY v.channel_sk
) metrics ON metrics.channel_sk = c.channel_sk

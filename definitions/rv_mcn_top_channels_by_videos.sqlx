config {
  type: "view",
  schema: "reporting",
  name: "rv_mcn_top_channels_by_videos",
  description: "Top Channels by Videos - For MCN Overview Dashboard",
  tags: ["reporting", "mcn", "channels", "dashboard"]
}

/*
 * Top Channels by Videos View
 * 
 * Purpose: Returns top channels ranked by total videos
 * 
 * Source: silver.silver_channel
 */

WITH latest_snapshot AS (
  SELECT MAX(snapshot_date) AS max_date
  FROM ${ref("silver", "silver_channel")}
)
SELECT 
  channel_id,
  channel_title,
  mcn_group_id,
  video_count_total AS total_videos
FROM ${ref("silver", "silver_channel")}
CROSS JOIN latest_snapshot ls
WHERE snapshot_date = ls.max_date
ORDER BY video_count_total DESC
LIMIT 10


config {
  type: "table",
  schema: "gold",
  name: "dim_channel",
  description: "Channel dimension with SCD2 (Slowly Changing Dimension Type 2)",
  tags: ["gold", "dimension", "channel", "scd2"],
  
  bigquery: {
    clusterBy: ["mcn_group_sk"]
  }
}

/*
 * Channel dimension with SCD2 implementation
 * Tracks historical changes to channel attributes
 * Links to MCN groups for analytics
 * 
 * SCD2 Logic:
 * - effective_start_date: Set to CURRENT_DATE() when record is inserted (audit column)
 * - effective_end_date: Calculated as the next record's effective_start_date - 1 day, or NULL if current
 * - is_current: Calculated dynamically - TRUE for record with latest effective_start_date per channel_id
 * - created_at: Original channel creation timestamp from source data
 * 
 * Note: In Dataform incremental mode, we can only INSERT new records (no UPDATE/DELETE).
 * This query only inserts NEW records when changes are detected.
 * To get current records, filter by: effective_start_date = MAX(effective_start_date) per channel_id
 */

WITH channel_data AS (
  SELECT
    channel_id,
    channel_title,
    mcn_group_id,
    created_at,
    snapshot_date
  FROM ${ref("silver", "silver_channel")}
  WHERE channel_id IS NOT NULL
),

mcn_lookup AS (
  SELECT
    g.mcn_group_sk,
    s.mcn_group_id
  FROM ${ref("gold", "dim_mcn_group")} g
  JOIN ${ref("silver", "silver_mcn_group")} s ON g.mcn_group_name = s.mcn_group_name
),

channel_with_mcn AS (
  SELECT
    c.channel_id,
    c.channel_title,
    m.mcn_group_sk,
    c.created_at,
    c.snapshot_date
  FROM channel_data c
  LEFT JOIN mcn_lookup m ON c.mcn_group_id = m.mcn_group_id
),

-- Get latest snapshot per channel to identify current state
latest_channel_snapshot AS (
  SELECT
    channel_id,
    MAX(snapshot_date) AS latest_snapshot_date
  FROM channel_with_mcn
  GROUP BY channel_id
),

-- Get current state from latest snapshot
current_channel_state AS (
  SELECT
    c.channel_id,
    c.channel_title,
    c.mcn_group_sk,
    c.created_at,
    c.snapshot_date
  FROM channel_with_mcn c
  INNER JOIN latest_channel_snapshot l
    ON c.channel_id = l.channel_id
    AND c.snapshot_date = l.latest_snapshot_date
),

-- Get existing current records from dimension table
-- Use direct table reference to avoid circular dependency in incremental mode
existing_current_records AS (
  SELECT
    channel_sk,
    channel_id,
    channel_title,
    mcn_group_sk,
    created_at,
    effective_start_date,
    effective_end_date,
    is_current
  FROM `tonal-transit-475913-a2.gold.dim_channel`
  WHERE is_current = TRUE
),

-- Detect changes: compare current state with existing records
changed_channels AS (
  SELECT
    c.channel_id,
    c.channel_title,
    c.mcn_group_sk,
    c.created_at,
    e.channel_sk AS existing_channel_sk,
    e.channel_title AS existing_channel_title,
    e.mcn_group_sk AS existing_mcn_group_sk,
    -- Check if any attribute changed
    CASE 
      WHEN e.channel_id IS NULL THEN TRUE  -- New channel
      WHEN c.channel_title != e.channel_title THEN TRUE  -- Title changed
      WHEN c.mcn_group_sk != e.mcn_group_sk 
        OR (c.mcn_group_sk IS NULL AND e.mcn_group_sk IS NOT NULL)
        OR (c.mcn_group_sk IS NOT NULL AND e.mcn_group_sk IS NULL)
      THEN TRUE  -- MCN group changed
      ELSE FALSE  -- No change
    END AS has_change
  FROM current_channel_state c
  LEFT JOIN existing_current_records e
    ON c.channel_id = e.channel_id
),

-- Get max channel_sk to generate new surrogate keys
-- Use direct table reference to avoid circular dependency in incremental mode
max_channel_sk AS (
  SELECT COALESCE(MAX(channel_sk), 0) AS max_sk
  FROM `tonal-transit-475913-a2.gold.dim_channel`
),

-- Prepare new/updated records to insert
-- Note: In Dataform incremental mode, we can only INSERT new records
new_records AS (
  SELECT
    c.channel_id,
    c.channel_title,
    c.mcn_group_sk,
    c.created_at,
    -- Generate new surrogate key: use max_sk + row_number for new records
    m.max_sk + ROW_NUMBER() OVER (ORDER BY c.channel_id) AS channel_sk,
    -- Set effective_start_date to today (audit column - insertion time)
    CURRENT_DATE() AS effective_start_date
  FROM changed_channels c
  CROSS JOIN max_channel_sk m
  WHERE c.has_change = TRUE
),

-- Get all existing records to calculate SCD2 fields for new records
all_existing_records AS (
  SELECT
    channel_sk,
    channel_id,
    channel_title,
    mcn_group_sk,
    created_at,
    effective_start_date
  FROM `tonal-transit-475913-a2.gold.dim_channel`
),

-- Combine existing + new records to calculate effective_end_date for new records
all_records AS (
  SELECT
    channel_sk,
    channel_id,
    channel_title,
    mcn_group_sk,
    created_at,
    effective_start_date
  FROM all_existing_records
  
  UNION ALL
  
  SELECT
    channel_sk,
    channel_id,
    channel_title,
    mcn_group_sk,
    created_at,
    effective_start_date
  FROM new_records
),

-- Calculate SCD2 fields using window functions
-- This determines effective_end_date and is_current for new records
scd2_calculated AS (
  SELECT
    channel_sk,
    channel_id,
    channel_title,
    mcn_group_sk,
    created_at,
    effective_start_date,
    -- Calculate effective_end_date: next record's effective_start_date - 1 day
    DATE_SUB(
      LEAD(effective_start_date) OVER (
        PARTITION BY channel_id 
        ORDER BY effective_start_date
      ),
      INTERVAL 1 DAY
    ) AS effective_end_date,
    -- Calculate is_current: TRUE if this is the latest record for this channel_id
    CASE 
      WHEN LEAD(effective_start_date) OVER (
        PARTITION BY channel_id 
        ORDER BY effective_start_date
      ) IS NULL THEN TRUE 
      ELSE FALSE 
    END AS is_current
  FROM all_records
)

-- Build complete SCD2 table with all records and correct flags
-- This replaces the entire table, ensuring all records have correct is_current and effective_end_date
-- Note: ORDER BY removed to avoid conflict with table clustering
SELECT
  channel_sk,
  channel_id,
  channel_title,
  mcn_group_sk,
  created_at,
  effective_start_date,
  effective_end_date,
  is_current
FROM scd2_calculated

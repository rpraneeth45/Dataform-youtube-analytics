config {
  type: "view",
  schema: "reporting",
  name: "v_seo_score_distribution",
  description: "SEO score distribution by video length cohort",
  tags: ["reporting", "seo", "distribution", "analytics", "charts"]
}

/*
 * SEO Score Distribution View
 * 
 * Purpose: Provides average SEO scores for each video length category (Short, Regular, Long)
 * for creating histogram/bar charts showing SEO performance by video length.
 * 
 * Business Logic:
 * - Groups videos by length bucket (Short, Mid, Long)
 * - Calculates average SEO scores per category
 * - Filters for videos published in the last 90 days
 * - Orders by length category for consistent chart display
 * 
 * Columns:
 *   length_bucket        : video length category (Short, Mid, Long)
 *   avg_seo_score        : average SEO score for the length category (0-100)
 *   video_count          : number of videos in the category
 *   channel_sk           : surrogate key for the channel (for filtering)
 *   channel_id           : YouTube channel id
 *   channel_title        : Channel title
 */

WITH video_metrics AS (
  SELECT
    dv.channel_sk,
    c.channel_id,
    c.channel_title,
    dv.length_bucket,
    dv.seo_score,
    dv.published_at
  FROM ${ref("gold", "dim_video")} dv
  LEFT JOIN ${ref("gold", "dim_channel")} c 
    ON dv.channel_sk = c.channel_sk
  WHERE dv.is_current = TRUE
    AND c.is_current = TRUE
    -- Filter for videos published in the last 90 days (configurable)
    AND dv.published_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 90 DAY)
)

SELECT
  channel_sk,
  channel_id,
  channel_title,
  length_bucket,
  ROUND(AVG(seo_score), 1) AS avg_seo_score,
  COUNT(*) AS video_count
FROM video_metrics
GROUP BY channel_sk, channel_id, channel_title, length_bucket
ORDER BY 
  CASE length_bucket 
    WHEN 'Short' THEN 1 
    WHEN 'Mid' THEN 2 
    WHEN 'Long' THEN 3 
    ELSE 4 
  END

config {
  type: "incremental",
  schema: "silver",
  name: "silver_playlist",
  description: "YouTube playlist metadata (transactional - one record per playlist per date)",
  tags: ["silver", "playlists"],
  
  uniqueKey: ["playlist_id", "snapshot_date"],
  
  bigquery: {
    partitionBy: "snapshot_date",
    clusterBy: ["channel_id", "playlist_id"]
  },
  
  columns: {
    playlist_id: "YouTube playlist ID",
    channel_id: "YouTube channel ID (foreign key)",
    title: "Playlist title",
    description: "Playlist description",
    item_count: "Number of items in playlist",
    published_at: "Playlist creation timestamp",
    snapshot_date: "Date of data snapshot (partition key)"
  }
}



/*
 * Step 1: UNNEST bronze playlists data
 * Unnests the items array from bronze_playlists_external to create one row per playlist
 */
WITH unnested_playlists AS (
  SELECT
    -- Playlist identifier from YouTube API response (item.id)
    item.id AS playlist_id,
    
    -- Channel identifier from YouTube API response (item.snippet.channelId)
    item.snippet.channelId AS channel_id,
    
    -- Playlist title from YouTube API response (item.snippet.title)
    item.snippet.title AS title,
    
    -- Playlist description from YouTube API response (item.snippet.description)
    item.snippet.description AS description,
    
    -- Number of items/videos in playlist from YouTube API (item.contentDetails.itemCount)
    item.contentDetails.itemCount AS item_count,
    
    -- Playlist creation timestamp from YouTube API response (item.snippet.publishedAt)
    -- Already a TIMESTAMP type from struct
    item.snippet.publishedAt AS published_at,
    
    -- Date of data snapshot from bronze table struct (bronze.snapshot_date)
    bronze.snapshot_date AS snapshot_date

  FROM 
    `tonal-transit-475913-a2.control.bronze_playlists_external` AS bronze
  CROSS JOIN UNNEST(bronze.items) AS item

  WHERE
    -- Only process records with valid playlist IDs
    item.id IS NOT NULL
    
    -- Date filter: process specific date from DAG parameter (if provided)
    ${ when(dataform.projectConfig.vars.target_date, 
      `AND bronze.snapshot_date = PARSE_DATE('%Y-%m-%d', '${dataform.projectConfig.vars.target_date}')`
    ) }
    
    -- Incremental mode: process last 7 days rolling window (if not full refresh and no target_date)
    -- Only applies when: incremental mode AND no full_refresh variable AND no target_date
    ${ when(incremental() && !dataform.projectConfig.vars.full_refresh && !dataform.projectConfig.vars.target_date, 
      `AND bronze.snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
    ) }
    -- If full_refresh is set or first run, process ALL dates from Bronze
),

/*
 * Step 2: Deduplicate playlists
 * Removes duplicates when same playlist_id appears multiple times for the same snapshot_date
 * Uses ROW_NUMBER() partitioned by playlist_id + snapshot_date
 * Orders by item_count DESC (prefer playlists with more items), then published_at DESC (prefer newer playlists)
 */
deduplicated_playlists AS (
  SELECT
    *,
    -- Row number for deduplication: 1 = keep, >1 = duplicate
    ROW_NUMBER() OVER (
      PARTITION BY playlist_id, snapshot_date 
      ORDER BY item_count DESC, published_at DESC  -- Prefer larger playlists, then newer playlists
    ) AS rn
  FROM unnested_playlists
)

/*
 * Step 3: Final SELECT
 * Returns deduplicated playlist records with all metadata
 */
SELECT
  -- Playlist identifier from unnested bronze data
  playlist_id,
  
  -- Channel identifier from unnested bronze data
  channel_id,
  
  -- Playlist title from unnested bronze data
  title,
  
  -- Playlist description from unnested bronze data
  description,
  
  -- Number of items in playlist from unnested bronze data
  item_count,
  
  -- Playlist creation timestamp from unnested bronze data
  published_at,
  
  -- Date of data snapshot from unnested bronze data
  snapshot_date

FROM deduplicated_playlists
WHERE
  -- Only keep the first row per playlist_id + snapshot_date (deduplication filter)
  rn = 1
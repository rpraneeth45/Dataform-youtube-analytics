config {
  type: "view",
  schema: "reporting",
  name: "v_seo_health_trends",
  description: "SEO health trends over time",
  tags: ["reporting", "seo", "trends", "time-series", "analytics"]
}

/*
 * SEO Health Trends View
 * 
 * Purpose: Provides time-series data for SEO health metrics to track improvements
 * over time and identify trends in SEO performance.
 * 
 * Business Logic:
 * - Groups videos by publication date and channel
 * - Calculates daily SEO metrics and percentages
 * - Tracks trends in SEO element adoption
 * - Orders by date (descending) for recent-first display
 * 
 * Columns:
 *   date_key             : integer date_key (YYYYMMDD)
 *   full_date            : parsed DATE
 *   channel_sk           : surrogate key for the channel
 *   channel_id           : YouTube channel id
 *   channel_title        : Channel title
 *   avg_seo_score        : average SEO score for the day
 *   videos_published     : number of videos published on this date
 *   pct_with_tags        : percentage of videos with tags published on this date
 *   pct_with_thumbnails  : percentage of videos with custom thumbnails published on this date
 *   pct_with_captions    : percentage of videos with captions published on this date
 */

WITH daily_video_metrics AS (
  SELECT
    dv.video_sk,
    dv.channel_sk,
    c.channel_id,
    c.channel_title,
    dv.seo_score,
    dv.has_tags,
    dv.has_custom_thumbnail,
    dv.has_captions,
    dv.published_at,
    CAST(FORMAT_DATE('%Y%m%d', DATE(dv.published_at)) AS INT64) AS date_key
  FROM ${ref("gold", "dim_video")} dv
  LEFT JOIN ${ref("gold", "dim_channel")} c 
    ON dv.channel_sk = c.channel_sk
  WHERE dv.is_current = TRUE
    AND c.is_current = TRUE
    -- Filter for videos published in the last 90 days (configurable)
    AND dv.published_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 90 DAY)
)

SELECT
  date_key,
  DATE(PARSE_DATE('%Y%m%d', CAST(date_key AS STRING))) AS full_date,
  channel_sk,
  channel_id,
  channel_title,
  ROUND(AVG(seo_score), 1) AS avg_seo_score,
  COUNT(*) AS videos_published,
  ROUND(SAFE_DIVIDE(COUNTIF(has_tags = TRUE), COUNT(*)) * 100, 1) AS pct_with_tags,
  ROUND(SAFE_DIVIDE(COUNTIF(has_custom_thumbnail = TRUE), COUNT(*)) * 100, 1) AS pct_with_thumbnails,
  ROUND(SAFE_DIVIDE(COUNTIF(has_captions = TRUE), COUNT(*)) * 100, 1) AS pct_with_captions
FROM daily_video_metrics
GROUP BY date_key, channel_sk, channel_id, channel_title
ORDER BY date_key DESC, channel_sk

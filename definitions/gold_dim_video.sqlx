config {
  type: "incremental",
  schema: "gold",
  name: "dim_video",
  description: "Video dimension with SCD2 and SEO attributes",
  tags: ["gold", "dimension", "video", "scd2", "seo"],
  
  bigquery: {
    clusterBy: ["channel_sk", "length_bucket"]
  }
}

/*
 * Video dimension with SCD2 implementation
 * Tracks historical changes to video attributes
 * Includes SEO metrics and length categorization
 * 
 * SCD2 Logic:
 * - effective_start_date: Set to CURRENT_DATE() when record is inserted (audit column)
 * - effective_end_date: Set to CURRENT_DATE() - 1 when record becomes inactive (audit column)
 * - is_current: Automatically set to FALSE for previous records when new record arrives
 * - created_at: Original video publish timestamp from source data (published_at)
 */

WITH video_data AS (
  SELECT
    video_id,
    channel_id,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    snapshot_date
  FROM ${ref("silver", "silver_video")}
  WHERE video_id IS NOT NULL
),

channel_lookup AS (
  SELECT
    channel_sk,
    channel_id,
    is_current
  FROM ${ref("gold", "dim_channel")}
  WHERE is_current = TRUE
),

video_with_channel AS (
  SELECT
    v.video_id,
    c.channel_sk,
    v.title,
    v.description,
    v.published_at,
    v.duration_sec,
    v.has_tags,
    v.has_custom_thumbnail,
    v.has_captions,
    v.title_len,
    v.description_len,
    v.seo_score,
    v.snapshot_date
  FROM video_data v
  LEFT JOIN channel_lookup c ON v.channel_id = c.channel_id
),

-- Add length bucket categorization
video_with_buckets AS (
  SELECT
    *,
    CASE 
      WHEN duration_sec < 60 THEN 'Short'
      WHEN duration_sec < 300 THEN 'Mid'  -- 5 minutes
      ELSE 'Long'
    END AS length_bucket
  FROM video_with_channel
),

-- Get latest snapshot per video to identify current state
latest_video_snapshot AS (
  SELECT
    video_id,
    MAX(snapshot_date) AS latest_snapshot_date
  FROM video_with_buckets
  GROUP BY video_id
),

-- Get current state from latest snapshot
current_video_state AS (
  SELECT
    v.video_id,
    v.channel_sk,
    v.title,
    v.description,
    v.published_at,
    v.duration_sec,
    v.has_tags,
    v.has_custom_thumbnail,
    v.has_captions,
    v.title_len,
    v.description_len,
    v.seo_score,
    v.length_bucket,
    v.snapshot_date
  FROM video_with_buckets v
  INNER JOIN latest_video_snapshot l
    ON v.video_id = l.video_id
    AND v.snapshot_date = l.latest_snapshot_date
),

-- Get existing current records from dimension table
-- Use direct table reference to avoid circular dependency in incremental mode
existing_current_records AS (
  SELECT
    video_sk,
    video_id,
    channel_sk,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    length_bucket,
    effective_start_date,
    effective_end_date,
    is_current
  FROM `tonal-transit-475913-a2.gold.dim_video`
  WHERE is_current = TRUE
),

-- Detect changes: compare current state with existing records
changed_videos AS (
  SELECT
    c.video_id,
    c.channel_sk,
    c.title,
    c.description,
    c.published_at,
    c.duration_sec,
    c.has_tags,
    c.has_custom_thumbnail,
    c.has_captions,
    c.title_len,
    c.description_len,
    c.seo_score,
    c.length_bucket,
    e.video_sk AS existing_video_sk,
    e.title AS existing_title,
    e.seo_score AS existing_seo_score,
    -- Check if any tracked attribute changed
    CASE 
      WHEN e.video_id IS NULL THEN TRUE  -- New video
      WHEN c.title != e.title THEN TRUE  -- Title changed
      WHEN c.seo_score != e.seo_score 
        OR (c.seo_score IS NULL AND e.seo_score IS NOT NULL)
        OR (c.seo_score IS NOT NULL AND e.seo_score IS NULL)
      THEN TRUE  -- SEO score changed
      ELSE FALSE  -- No change
    END AS has_change
  FROM current_video_state c
  LEFT JOIN existing_current_records e
    ON c.video_id = e.video_id
),

-- Get max video_sk to generate new surrogate keys
-- Use direct table reference to avoid circular dependency in incremental mode
max_video_sk AS (
  SELECT COALESCE(MAX(video_sk), 0) AS max_sk
  FROM `tonal-transit-475913-a2.gold.dim_video`
),

-- Prepare records to deactivate (previous records that are being superseded)
records_to_deactivate AS (
  SELECT
    e.video_sk,
    e.video_id,
    e.channel_sk,
    e.title,
    e.description,
    e.published_at,
    e.duration_sec,
    e.has_tags,
    e.has_custom_thumbnail,
    e.has_captions,
    e.title_len,
    e.description_len,
    e.seo_score,
    e.length_bucket,
    e.effective_start_date,
    -- Set effective_end_date to yesterday (when new record takes effect)
    DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY) AS effective_end_date,
    -- Mark as inactive
    FALSE AS is_current
  FROM existing_current_records e
  INNER JOIN changed_videos c
    ON e.video_id = c.video_id
  WHERE c.has_change = TRUE
),

-- Prepare new/updated records to activate
records_to_activate AS (
  SELECT
    c.video_id,
    c.channel_sk,
    c.title,
    c.description,
    c.published_at,
    c.duration_sec,
    c.has_tags,
    c.has_custom_thumbnail,
    c.has_captions,
    c.title_len,
    c.description_len,
    c.seo_score,
    c.length_bucket,
    -- Generate new surrogate key: use max_sk + row_number
    m.max_sk + ROW_NUMBER() OVER (ORDER BY c.video_id) AS video_sk,
    -- Set effective_start_date to today (audit column - insertion time)
    CURRENT_DATE() AS effective_start_date,
    -- No end date for current records (cast NULL as DATE to match UNION ALL type)
    CAST(NULL AS DATE) AS effective_end_date,
    -- Mark as current
    TRUE AS is_current
  FROM changed_videos c
  CROSS JOIN max_video_sk m
  WHERE c.has_change = TRUE
),

-- Combine all records: deactivated + new/updated
all_scd2_records AS (
  SELECT
    video_sk,
    video_id,
    channel_sk,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    length_bucket,
    TIMESTAMP(published_at) AS created_at,
    effective_start_date,
    effective_end_date,
    is_current
  FROM records_to_deactivate
  
  UNION ALL
  
  SELECT
    video_sk,
    video_id,
    channel_sk,
    title,
    description,
    published_at,
    duration_sec,
    has_tags,
    has_custom_thumbnail,
    has_captions,
    title_len,
    description_len,
    seo_score,
    length_bucket,
    TIMESTAMP(published_at) AS created_at,
    effective_start_date,
    effective_end_date,
    is_current
  FROM records_to_activate
)

SELECT
  video_sk,
  video_id,
  channel_sk,
  title,
  description,
  published_at,
  duration_sec,
  has_tags,
  has_custom_thumbnail,
  has_captions,
  title_len,
  description_len,
  seo_score,
  length_bucket,
  created_at,
  effective_start_date,
  effective_end_date,
  is_current
FROM all_scd2_records

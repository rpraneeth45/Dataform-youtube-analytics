config {
  type: "view",
  schema: "reporting",
  name: "rv_seo_underperforming_channels",
  description: "Underperforming Channels by SEO Score - Table for SEO Dashboard",
  tags: ["reporting", "seo", "channels", "dashboard"]
}

/*
 * Underperforming Channels by SEO Score View
 * 
 * Purpose: Returns channels with average SEO score below 70
 * 
 * Source: silver.silver_video, silver.silver_channel
 */

WITH latest_snapshot AS (
  SELECT MAX(snapshot_date) AS max_date
  FROM ${ref("silver", "silver_video")}
),
channel_seo AS (
  SELECT 
    sv.channel_id,
    sc.channel_title,
    AVG(sv.seo_score) AS avg_seo_score,
    COUNT(sv.video_id) AS video_count
  FROM ${ref("silver", "silver_video")} sv
  JOIN ${ref("silver", "silver_channel")} sc
    ON sv.channel_id = sc.channel_id
    AND sv.snapshot_date = sc.snapshot_date
  CROSS JOIN latest_snapshot ls
  WHERE sv.snapshot_date = ls.max_date
  GROUP BY sv.channel_id, sc.channel_title
  HAVING AVG(sv.seo_score) < 70
)
SELECT * FROM channel_seo
ORDER BY avg_seo_score ASC

